# Apple build settings (macOS and iOS), read by tools/apple_env.py.
# Copy this file to .env and fill in your own values; a variable set in the
# shell's environment wins over the file's. Re-run `python3 configure.py`
# (or just `ninja`, which re-configures when .env changes) after editing.

# ---------- iOS (ninja ios, tools/ios_deploy.py, tools/ios_testflight.py)

# The app's bundle identifier. It must be one your Apple developer team can
# sign: an installed provisioning profile (Xcode > Settings > Accounts, or a
# throwaway Xcode project with this identifier) must cover it.
HALO_IOS_BUNDLE_ID=com.halo.decomp

# Your developer team's 10-character ID (developer.apple.com > Membership).
# Used for TestFlight exports; empty takes the development profile's team.
HALO_IOS_TEAM=

# A specific .mobileprovision file to sign device builds with; empty picks the
# best installed profile that covers HALO_IOS_BUNDLE_ID.
HALO_IOS_PROFILE=

# The version shown to users (CFBundleShortVersionString) and the build number
# (CFBundleVersion; tools/ios_testflight.py uses the time unless --build).
HALO_IOS_VERSION=1.0
HALO_IOS_BUILD=1

# The oldest iOS the app runs on.
HALO_IOS_MINIMUM=16.0

# ---------- macOS (ninja macos)

HALO_MACOS_BUNDLE_ID=com.halo.decomp

# The codesign identity: "-" signs ad hoc (runs on your own Mac); or a
# certificate's name or SHA-1 from `security find-identity -v -p codesigning`,
# e.g. "Developer ID Application: Your Name (TEAMID1234)".
HALO_MACOS_SIGN_IDENTITY=-

# The oldest macOS the app runs on.
HALO_MACOS_MINIMUM=13.0
